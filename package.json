{
  "name": "typescript-todo-app",
  "version": "1.0.0",
  "description": "Two-panel Todo App with Admin and User roles built with TypeScript, Express.js, MySQL, Knex, and EJS",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "migrate:make": "knex --knexfile knexfile.ts migrate:make -x ts",
    "migrate:latest": "knex --knexfile knexfile.ts migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.ts migrate:rollback",
    "seed:run": "knex --knexfile knexfile.ts seed:run",
    "setup:db": "ts-node src/scripts/init-db.ts",
    "test": "NODE_ENV=test ts-node src/tests/integration.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-flash": "^0.1.1",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "knex": "^3.1.0",
    "method-override": "^3.0.0",
    "mysql2": "^3.12.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/connect-flash": "^0.0.40",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/method-override": "^3.0.0",
    "@types/node": "^22.13.5",
    "sqlite3": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
