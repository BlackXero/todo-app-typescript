<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container-fluid px-lg-5 py-4">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2">
        <h2 class="fw-bold mb-0">Admin Control Center</h2>
        <span class="badge bg-danger rounded-pill px-3 py-1">Superuser Access</span>
      </div>
      <p class="text-muted small mb-0 mt-1">Global oversight and management across all user accounts and system tasks</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/admin/todos" class="btn btn-outline-dark rounded-pill px-3">
        <i class="bi bi-list-task me-1"></i> Full Todo Table
      </a>
      <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#adminCreateTodoModal">
        <i class="bi bi-plus-circle-fill"></i>
        <span>Assign New Task</span>
      </button>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <!-- System Metrics -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="card stat-card stat-blue p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="text-white-50 text-uppercase small fw-semibold">Registered Users</div>
            <h3 class="fw-bold mb-0 mt-1"><%= userCount %></h3>
          </div>
          <i class="bi bi-people-fill fs-1 text-white-50"></i>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card stat-card stat-indigo p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="text-white-50 text-uppercase small fw-semibold">Total System Todos</div>
            <h3 class="fw-bold mb-0 mt-1"><%= stats.total %></h3>
          </div>
          <i class="bi bi-layers-fill fs-1 text-white-50"></i>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card stat-card stat-amber p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="text-white-50 text-uppercase small fw-semibold">Pending / In Progress</div>
            <h3 class="fw-bold mb-0 mt-1"><%= stats.pending + stats.in_progress %></h3>
          </div>
          <i class="bi bi-hourglass-bottom fs-1 text-white-50"></i>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="card stat-card stat-emerald p-3">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <div class="text-white-50 text-uppercase small fw-semibold">Completed</div>
            <h3 class="fw-bold mb-0 mt-1"><%= stats.completed %></h3>
          </div>
          <i class="bi bi-check-circle-fill fs-1 text-white-50"></i>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4">
    <!-- Recent Todos across all users -->
    <div class="col-12 col-xl-8">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
          <h5 class="fw-bold mb-0"><i class="bi bi-clock-history text-primary me-2"></i>Recent System Todos</h5>
          <a href="/admin/todos" class="text-primary text-decoration-none small fw-semibold">View All &rarr;</a>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-4">Task & Description</th>
                <th>Assigned User</th>
                <th>Priority</th>
                <th>Status</th>
                <th class="text-end pe-4">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentTodos.length === 0) { %>
                <tr>
                  <td colspan="5" class="text-center py-4 text-muted">No todos in system.</td>
                </tr>
              <% } else { %>
                <% recentTodos.forEach(todo => { %>
                  <tr>
                    <td class="ps-4">
                      <div class="fw-semibold <%= todo.status === 'completed' ? 'todo-completed-title' : '' %>"><%= todo.title %></div>
                      <% if (todo.description) { %>
                        <div class="text-muted small text-truncate" style="max-width: 260px;"><%= todo.description %></div>
                      <% } %>
                    </td>
                    <td>
                      <div class="d-flex align-items-center gap-1.5">
                        <i class="bi bi-person-fill text-muted"></i>
                        <span class="small fw-medium"><%= todo.username %></span>
                      </div>
                      <small class="text-muted d-block" style="font-size: 0.75rem;"><%= todo.email %></small>
                    </td>
                    <td>
                      <span class="badge badge-priority-<%= todo.priority %> text-uppercase rounded-pill px-2 py-0.5" style="font-size: 0.65rem;">
                        <%= todo.priority %>
                      </span>
                    </td>
                    <td>
                      <span class="badge badge-status-<%= todo.status %> text-uppercase rounded-pill px-2 py-0.5" style="font-size: 0.65rem;">
                        <%= todo.status.replace('_', ' ') %>
                      </span>
                    </td>
                    <td class="text-end pe-4">
                      <div class="d-inline-flex gap-1">
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-circle" style="width: 30px; height: 30px; padding: 0;" title="Edit / Reassign"
                          data-bs-toggle="modal"
                          data-bs-target="#adminEditTodoModal"
                          data-id="<%= todo.id %>"
                          data-userid="<%= todo.user_id %>"
                          data-title="<%= todo.title %>"
                          data-description="<%= todo.description || '' %>"
                          data-status="<%= todo.status %>"
                          data-priority="<%= todo.priority %>"
                          data-duedate="<%= todo.due_date ? new Date(todo.due_date).toISOString().split('T')[0] : '' %>">
                          <i class="bi bi-pencil" style="font-size: 0.8rem;"></i>
                        </button>
                        <form action="/admin/todos/<%= todo.id %>/delete" method="POST" class="m-0" onsubmit="return confirm('Admin Delete: Permanently remove this task?');">
                          <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" style="width: 30px; height: 30px; padding: 0;" title="Delete">
                            <i class="bi bi-trash" style="font-size: 0.8rem;"></i>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Registered Users Overview -->
    <div class="col-12 col-xl-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-0 py-3">
          <h5 class="fw-bold mb-0"><i class="bi bi-person-lines-fill text-primary me-2"></i>User Directory</h5>
        </div>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th class="ps-3">User</th>
                <th>Role</th>
                <th class="text-end pe-3">Todos</th>
              </tr>
            </thead>
            <tbody>
              <% users.forEach(user => { %>
                <tr>
                  <td class="ps-3">
                    <div class="fw-semibold"><%= user.username %></div>
                    <small class="text-muted"><%= user.email %></small>
                  </td>
                  <td>
                    <span class="badge <%= user.role === 'admin' ? 'bg-danger' : 'bg-secondary' %> text-uppercase rounded-pill" style="font-size: 0.65rem;">
                      <%= user.role %>
                    </span>
                  </td>
                  <td class="text-end pe-3">
                    <a href="/admin/todos?userId=<%= user.id %>" class="badge bg-primary-subtle text-primary text-decoration-none rounded-pill px-2.5 py-1">
                      <%= user.todo_count %> tasks
                    </a>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</main>

<!-- Admin Create Modal -->
<div class="modal fade" id="adminCreateTodoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow rounded-4">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Assign & Create Todo</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/admin/todos" method="POST">
        <div class="modal-body py-4">
          <div class="mb-3">
            <label for="adminCreateUserId" class="form-label fw-medium small">Assign to User <span class="text-danger">*</span></label>
            <select class="form-select" id="adminCreateUserId" name="user_id" required>
              <% users.forEach(user => { %>
                <option value="<%= user.id %>"><%= user.username %> (<%= user.email %>) - [<%= user.role %>]</option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label for="adminCreateTitle" class="form-label fw-medium small">Task Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="adminCreateTitle" name="title" required>
          </div>
          <div class="mb-3">
            <label for="adminCreateDescription" class="form-label fw-medium small">Description</label>
            <textarea class="form-control" id="adminCreateDescription" name="description" rows="3"></textarea>
          </div>
          <div class="row g-2">
            <div class="col-6 mb-3">
              <label for="adminCreateStatus" class="form-label fw-medium small">Status</label>
              <select class="form-select" id="adminCreateStatus" name="status">
                <option value="pending" selected>Pending</option>
                <option value="in_progress">In Progress</option>
                <option value="completed">Completed</option>
              </select>
            </div>
            <div class="col-6 mb-3">
              <label for="adminCreatePriority" class="form-label fw-medium small">Priority</label>
              <select class="form-select" id="adminCreatePriority" name="priority">
                <option value="low">Low</option>
                <option value="medium" selected>Medium</option>
                <option value="high">High</option>
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label for="adminCreateDueDate" class="form-label fw-medium small">Due Date</label>
            <input type="date" class="form-control" id="adminCreateDueDate" name="due_date">
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4">Create & Assign</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Admin Edit & Reassign Modal -->
<div class="modal fade" id="adminEditTodoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow rounded-4">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Admin Edit / Reassign Todo</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="adminEditTodoForm" method="POST">
        <div class="modal-body py-4">
          <div class="mb-3">
            <label for="adminEditUserId" class="form-label fw-medium small">Assigned Owner / Reassign <span class="text-danger">*</span></label>
            <select class="form-select" id="adminEditUserId" name="user_id" required>
              <% users.forEach(user => { %>
                <option value="<%= user.id %>"><%= user.username %> (<%= user.email %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label for="adminEditTitle" class="form-label fw-medium small">Task Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="adminEditTitle" name="title" required>
          </div>
          <div class="mb-3">
            <label for="adminEditDescription" class="form-label fw-medium small">Description</label>
            <textarea class="form-control" id="adminEditDescription" name="description" rows="3"></textarea>
          </div>
          <div class="row g-2">
            <div class="col-6 mb-3">
              <label for="adminEditStatus" class="form-label fw-medium small">Status</label>
              <select class="form-select" id="adminEditStatus" name="status">
                <option value="pending">Pending</option>
                <option value="in_progress">In Progress</option>
                <option value="completed">Completed</option>
              </select>
            </div>
            <div class="col-6 mb-3">
              <label for="adminEditPriority" class="form-label fw-medium small">Priority</label>
              <select class="form-select" id="adminEditPriority" name="priority">
                <option value="low">Low</option>
                <option value="medium">Medium</option>
                <option value="high">High</option>
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label for="adminEditDueDate" class="form-label fw-medium small">Due Date</label>
            <input type="date" class="form-control" id="adminEditDueDate" name="due_date">
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4">Update Todo</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
