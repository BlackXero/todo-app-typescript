<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="container-fluid px-lg-5 py-4">
  <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
      <div class="d-flex align-items-center gap-2">
        <h2 class="fw-bold mb-0">All System Todos</h2>
        <span class="badge bg-secondary rounded-pill px-2.5 py-1">Total: <%= pagination.totalCount %></span>
      </div>
      <p class="text-muted small mb-0 mt-1">Admin oversight and moderation table for all tasks created across the platform</p>
    </div>
    <div class="d-flex gap-2">
      <a href="/admin" class="btn btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> Dashboard
      </a>
      <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 rounded-pill px-3 shadow-sm" data-bs-toggle="modal" data-bs-target="#adminCreateTodoModal">
        <i class="bi bi-plus-circle-fill"></i>
        <span>Assign New Task</span>
      </button>
    </div>
  </div>

  <%- include('../partials/flash') %>

  <!-- Admin Filters Bar -->
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body p-3">
      <form action="/admin/todos" method="GET" class="row g-2 align-items-center">
        <div class="col-12 col-md-3">
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" name="search" class="form-control border-start-0" placeholder="Search title, user, email..." value="<%= filters.search %>">
          </div>
        </div>
        <div class="col-6 col-md-3">
          <select name="userId" class="form-select">
            <option value="all" <%= filters.userId === 'all' ? 'selected' : '' %>>All Users</option>
            <% users.forEach(user => { %>
              <option value="<%= user.id %>" <%= String(filters.userId) === String(user.id) ? 'selected' : '' %>>
                <%= user.username %> (<%= user.email %>)
              </option>
            <% }) %>
          </select>
        </div>
        <div class="col-6 col-md-2">
          <select name="status" class="form-select">
            <option value="all" <%= filters.status === 'all' ? 'selected' : '' %>>All Statuses</option>
            <option value="pending" <%= filters.status === 'pending' ? 'selected' : '' %>>Pending</option>
            <option value="in_progress" <%= filters.status === 'in_progress' ? 'selected' : '' %>>In Progress</option>
            <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
          </select>
        </div>
        <div class="col-6 col-md-2">
          <select name="priority" class="form-select">
            <option value="all" <%= filters.priority === 'all' ? 'selected' : '' %>>All Priorities</option>
            <option value="low" <%= filters.priority === 'low' ? 'selected' : '' %>>Low</option>
            <option value="medium" <%= filters.priority === 'medium' ? 'selected' : '' %>>Medium</option>
            <option value="high" <%= filters.priority === 'high' ? 'selected' : '' %>>High</option>
          </select>
        </div>
        <div class="col-6 col-md-2 d-flex gap-2">
          <button type="submit" class="btn btn-primary w-100 rounded-3">
            <i class="bi bi-funnel me-1"></i> Filter
          </button>
          <a href="/admin/todos" class="btn btn-outline-secondary rounded-3" title="Reset Filters">
            <i class="bi bi-arrow-counterclockwise"></i>
          </a>
        </div>
      </form>
    </div>
  </div>

  <!-- Todos Table -->
  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th class="ps-4">ID</th>
            <th>Task & Description</th>
            <th>Assigned User</th>
            <th>Priority</th>
            <th>Status</th>
            <th>Due Date</th>
            <th>Created</th>
            <th class="text-end pe-4">Admin Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (todos.length === 0) { %>
            <tr>
              <td colspan="8" class="text-center py-5 text-muted">
                <i class="bi bi-inbox fs-2 d-block mb-2 text-secondary opacity-50"></i>
                No tasks match your filter criteria.
              </td>
            </tr>
          <% } else { %>
            <% todos.forEach(todo => { %>
              <tr>
                <td class="ps-4 text-muted fw-mono">#<%= todo.id %></td>
                <td>
                  <div class="fw-semibold <%= todo.status === 'completed' ? 'todo-completed-title' : '' %>"><%= todo.title %></div>
                  <% if (todo.description) { %>
                    <div class="text-muted small text-truncate" style="max-width: 320px;"><%= todo.description %></div>
                  <% } %>
                </td>
                <td>
                  <div class="d-flex align-items-center gap-1.5">
                    <i class="bi bi-person-circle text-secondary"></i>
                    <span class="small fw-semibold"><%= todo.username %></span>
                  </div>
                  <small class="text-muted d-block" style="font-size: 0.75rem;"><%= todo.email %></small>
                </td>
                <td>
                  <span class="badge badge-priority-<%= todo.priority %> text-uppercase rounded-pill px-2.5 py-1" style="font-size: 0.65rem;">
                    <%= todo.priority %>
                  </span>
                </td>
                <td>
                  <span class="badge badge-status-<%= todo.status %> text-uppercase rounded-pill px-2.5 py-1" style="font-size: 0.65rem;">
                    <%= todo.status.replace('_', ' ') %>
                  </span>
                </td>
                <td class="small text-muted">
                  <% if (todo.due_date) { %>
                    <%= new Date(todo.due_date).toLocaleDateString() %>
                  <% } else { %>
                    <span class="text-muted fst-italic">-</span>
                  <% } %>
                </td>
                <td class="small text-muted">
                  <%= new Date(todo.created_at).toLocaleDateString() %>
                </td>
                <td class="text-end pe-4">
                  <div class="d-inline-flex gap-1">
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-circle" style="width: 32px; height: 32px; padding: 0;" title="Edit / Reassign"
                      data-bs-toggle="modal"
                      data-bs-target="#adminEditTodoModal"
                      data-id="<%= todo.id %>"
                      data-userid="<%= todo.user_id %>"
                      data-title="<%= todo.title %>"
                      data-description="<%= todo.description || '' %>"
                      data-status="<%= todo.status %>"
                      data-priority="<%= todo.priority %>"
                      data-duedate="<%= todo.due_date ? new Date(todo.due_date).toISOString().split('T')[0] : '' %>">
                      <i class="bi bi-pencil"></i>
                    </button>
                    <form action="/admin/todos/<%= todo.id %>/delete" method="POST" class="m-0" onsubmit="return confirm('Admin Delete: Permanently remove this task from the system?');">
                      <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" style="width: 32px; height: 32px; padding: 0;" title="Delete">
                        <i class="bi bi-trash"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (pagination.totalPages > 1) { %>
      <%
        const buildPageUrl = (p) => {
          const params = new URLSearchParams();
          if (filters.search) params.set('search', filters.search);
          if (filters.userId && filters.userId !== 'all') params.set('userId', filters.userId);
          if (filters.status && filters.status !== 'all') params.set('status', filters.status);
          if (filters.priority && filters.priority !== 'all') params.set('priority', filters.priority);
          params.set('page', String(p));
          return '/admin/todos?' + params.toString();
        };
      %>
      <div class="card-footer bg-white border-0 py-3 px-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2">
        <div class="small text-muted">
          Showing <strong><%= ((pagination.currentPage - 1) * pagination.limit) + 1 %></strong> to 
          <strong><%= Math.min(pagination.currentPage * pagination.limit, pagination.totalCount) %></strong> of 
          <strong><%= pagination.totalCount %></strong> todos
        </div>
        <nav aria-label="Todos pagination">
          <ul class="pagination pagination-sm mb-0">
            <li class="page-item <%= pagination.currentPage <= 1 ? 'disabled' : '' %>">
              <a class="page-link" href="<%= buildPageUrl(pagination.currentPage - 1) %>">Previous</a>
            </li>
            <% for (let p = Math.max(1, pagination.currentPage - 2); p <= Math.min(pagination.totalPages, pagination.currentPage + 2); p++) { %>
              <li class="page-item <%= p === pagination.currentPage ? 'active' : '' %>">
                <a class="page-link" href="<%= buildPageUrl(p) %>"><%= p %></a>
              </li>
            <% } %>
            <li class="page-item <%= pagination.currentPage >= pagination.totalPages ? 'disabled' : '' %>">
              <a class="page-link" href="<%= buildPageUrl(pagination.currentPage + 1) %>">Next</a>
            </li>
          </ul>
        </nav>
      </div>
    <% } %>
  </div>
</main>

<!-- Admin Create Modal -->
<div class="modal fade" id="adminCreateTodoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow rounded-4">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle text-primary me-2"></i>Assign & Create Todo</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form action="/admin/todos" method="POST">
        <div class="modal-body py-4">
          <div class="mb-3">
            <label for="adminCreateUserId" class="form-label fw-medium small">Assign to User <span class="text-danger">*</span></label>
            <select class="form-select" id="adminCreateUserId" name="user_id" required>
              <% users.forEach(user => { %>
                <option value="<%= user.id %>"><%= user.username %> (<%= user.email %>) - [<%= user.role %>]</option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label for="adminCreateTitle" class="form-label fw-medium small">Task Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="adminCreateTitle" name="title" required>
          </div>
          <div class="mb-3">
            <label for="adminCreateDescription" class="form-label fw-medium small">Description</label>
            <textarea class="form-control" id="adminCreateDescription" name="description" rows="3"></textarea>
          </div>
          <div class="row g-2">
            <div class="col-6 mb-3">
              <label for="adminCreateStatus" class="form-label fw-medium small">Status</label>
              <select class="form-select" id="adminCreateStatus" name="status">
                <option value="pending" selected>Pending</option>
                <option value="in_progress">In Progress</option>
                <option value="completed">Completed</option>
              </select>
            </div>
            <div class="col-6 mb-3">
              <label for="adminCreatePriority" class="form-label fw-medium small">Priority</label>
              <select class="form-select" id="adminCreatePriority" name="priority">
                <option value="low">Low</option>
                <option value="medium" selected>Medium</option>
                <option value="high">High</option>
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label for="adminCreateDueDate" class="form-label fw-medium small">Due Date</label>
            <input type="date" class="form-control" id="adminCreateDueDate" name="due_date">
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4">Create & Assign</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Admin Edit & Reassign Modal -->
<div class="modal fade" id="adminEditTodoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow rounded-4">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Admin Edit / Reassign Todo</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="adminEditTodoForm" method="POST">
        <div class="modal-body py-4">
          <div class="mb-3">
            <label for="adminEditUserId" class="form-label fw-medium small">Assigned Owner / Reassign <span class="text-danger">*</span></label>
            <select class="form-select" id="adminEditUserId" name="user_id" required>
              <% users.forEach(user => { %>
                <option value="<%= user.id %>"><%= user.username %> (<%= user.email %>)</option>
              <% }) %>
            </select>
          </div>
          <div class="mb-3">
            <label for="adminEditTitle" class="form-label fw-medium small">Task Title <span class="text-danger">*</span></label>
            <input type="text" class="form-control" id="adminEditTitle" name="title" required>
          </div>
          <div class="mb-3">
            <label for="adminEditDescription" class="form-label fw-medium small">Description</label>
            <textarea class="form-control" id="adminEditDescription" name="description" rows="3"></textarea>
          </div>
          <div class="row g-2">
            <div class="col-6 mb-3">
              <label for="adminEditStatus" class="form-label fw-medium small">Status</label>
              <select class="form-select" id="adminEditStatus" name="status">
                <option value="pending">Pending</option>
                <option value="in_progress">In Progress</option>
                <option value="completed">Completed</option>
              </select>
            </div>
            <div class="col-6 mb-3">
              <label for="adminEditPriority" class="form-label fw-medium small">Priority</label>
              <select class="form-select" id="adminEditPriority" name="priority">
                <option value="low">Low</option>
                <option value="medium">Medium</option>
                <option value="high">High</option>
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label for="adminEditDueDate" class="form-label fw-medium small">Due Date</label>
            <input type="date" class="form-control" id="adminEditDueDate" name="due_date">
          </div>
        </div>
        <div class="modal-footer border-0 pt-0">
          <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary rounded-pill px-4">Update Todo</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
