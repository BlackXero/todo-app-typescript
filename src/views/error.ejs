<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container my-auto py-5">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6 text-center">
      <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4">
        <div class="mb-3">
          <span class="badge bg-danger bg-opacity-10 text-danger fs-3 px-3 py-2 rounded-4">
            <%= typeof statusCode !== 'undefined' ? statusCode : 'Error' %>
          </span>
        </div>
        <h3 class="fw-bold mb-2"><%= typeof title !== 'undefined' ? title : 'An Error Occurred' %></h3>
        <p class="text-muted mb-4"><%= typeof message !== 'undefined' ? message : 'Something went wrong.' %></p>
        <div class="d-flex justify-content-center gap-2">
          <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i> Go Back
          </a>
          <a href="/" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-house-door me-1"></i> Return Home
          </a>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
