<nav class="navbar navbar-expand-lg navbar-dark <%= isAdmin ? 'bg-dark' : 'bg-primary' %> shadow-sm sticky-top">
  <div class="container-fluid px-lg-5">
    <a class="navbar-brand d-flex align-items-center gap-2 fw-bold text-white" href="/">
      <i class="bi bi-check2-circle fs-4"></i>
      <span>TodoFlow</span>
      <% if (isAdmin) { %>
        <span class="badge bg-danger text-uppercase ms-1" style="font-size: 0.65rem; letter-spacing: 0.05em;">Admin Portal</span>
      <% } %>
    </a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <% if (isAuthenticated) { %>
          <% if (isAdmin) { %>
            <li class="nav-item">
              <a class="nav-link <%= currentPath === '/admin' ? 'active fw-semibold' : '' %>" href="/admin">
                <i class="bi bi-speedometer2 me-1"></i> Admin Dashboard
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= currentPath === '/admin/todos' ? 'active fw-semibold' : '' %>" href="/admin/todos">
                <i class="bi bi-list-check me-1"></i> Manage All Todos
              </a>
            </li>
            <li class="nav-item">
              <a class="nav-link <%= currentPath === '/todos' ? 'active fw-semibold' : '' %> text-info-emphasis" href="/todos">
                <i class="bi bi-person me-1"></i> Switch to User View
              </a>
            </li>
          <% } else { %>
            <li class="nav-item">
              <a class="nav-link <%= currentPath === '/todos' ? 'active fw-semibold' : '' %>" href="/todos">
                <i class="bi bi-check2-square me-1"></i> My Todos
              </a>
            </li>
          <% } %>
        <% } %>
      </ul>

      <div class="d-flex align-items-center gap-3">
        <% if (isAuthenticated) { %>
          <div class="d-flex align-items-center text-light bg-white bg-opacity-10 px-3 py-1 rounded-pill">
            <i class="bi bi-person-circle fs-5 me-2"></i>
            <div>
              <span class="fw-semibold d-block lh-1 text-white"><%= currentUser.username %></span>
              <small class="text-white-50 text-uppercase" style="font-size: 0.65rem;"><%= currentUser.role %></small>
            </div>
          </div>
          <form action="/logout" method="POST" class="m-0">
            <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3">
              <i class="bi bi-box-arrow-right me-1"></i> Sign Out
            </button>
          </form>
        <% } else { %>
          <a href="/login" class="btn btn-outline-light btn-sm rounded-pill px-3">Sign In</a>
          <a href="/register" class="btn btn-light btn-sm rounded-pill px-3 text-primary fw-semibold">Sign Up</a>
        <% } %>
      </div>
    </div>
  </div>
</nav>
